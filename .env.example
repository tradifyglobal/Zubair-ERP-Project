# TradifyERP Environment Configuration
# Copy this to .env and fill in your actual values
# IMPORTANT: DO NOT commit .env to Git!

# === Django Configuration ===
DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-key-here-change-in-production

# === Database Configuration ===
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tradifyerp_db
DB_USER=tradifyerp_user
DB_PASSWORD=your-strong-password-here
DB_HOST=192.168.20.11
DB_PORT=5432

# === Encryption ===
ENCRYPTION_KEY=your-base64-encryption-key-here

# === Security ===
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# === Email Configuration ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=security@tradifyglobal.com
SECURITY_ADMIN_EMAIL=admin@tradifyglobal.com

# === Redis Cache ===
REDIS_URL=redis://127.0.0.1:6379/1

# === CORS Configuration ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === Allowed Hosts ===
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.5.10,tradifyglobal.com,www.tradifyglobal.com

# === CSRF Origins ===
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://tradifyglobal.com

# === AWS S3 (Optional - for backups) ===
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=tradifyerp-backups
# AWS_S3_REGION_NAME=us-east-1

# === Logging ===
LOG_LEVEL=INFO
