# Production Deployment Configuration
# Server: 192.168.20.10 (Web Server)
# Database: 192.168.20.11 (PostgreSQL)

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-this-will-be-generated-on-deployment
DEBUG=False
ALLOWED_HOSTS=192.168.20.10,tradifyglobal.com,www.tradifyglobal.com,localhost,127.0.0.1

# Database Configuration - PostgreSQL Server at 192.168.20.11
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tradifyerp_db
DB_USER=tradifyerp_user
DB_PASSWORD=Tradify@PostgreSQL2024
DB_HOST=192.168.20.11
DB_PORT=5432
DB_SSL_MODE=require

# Encryption Configuration
ENCRYPTION_KEY=this-will-be-generated-on-deployment

# Security Configuration
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email Configuration (for security alerts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@tradifyglobal.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=noreply@tradifyglobal.com

# Redis Configuration (local to web server)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=/var/log/tradifyerp

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://192.168.20.10,https://tradifyglobal.com,https://www.tradifyglobal.com

# Application Settings
ENVIRONMENT=production
APP_NAME=Tradify Global ERP
APP_VERSION=1.0.0
